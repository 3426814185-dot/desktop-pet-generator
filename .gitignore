.desktop-pet/
*.png
!docs/*.png

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
.DS_Store

# ---- 本机专用脚本（路径写死，不通用）----
make_shortcut*.ps1
check_shortcut*.ps1
