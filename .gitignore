# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- PyInstaller 产物 ----
build/
dist/
*.spec.bak

# ---- 运行时生成的数据 ----
